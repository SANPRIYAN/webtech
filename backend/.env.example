# ============================================================
#  ENVIRONMENT VARIABLES — SAMPLE FILE
#  Copy this file to ".env" and fill in your actual values.
#  NEVER commit the real ".env" file to GitHub.
# ============================================================

# -----------------------------------------------------------
# OPTION A: MongoDB Atlas (Cloud) — recommended for GitHub
# Replace <username>, <password>, and <cluster-url> below.
# You get this string from: Atlas → Connect → Drivers → Node.js
# -----------------------------------------------------------
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/web_lab?retryWrites=true&w=majority

# -----------------------------------------------------------
# OPTION B: Local MongoDB Community Server (Lab / Offline)
# Uncomment the line below and comment out OPTION A above.
# -----------------------------------------------------------
# MONGO_URI=mongodb://127.0.0.1:27017/web_lab

# -----------------------------------------------------------
# Server port (default: 5000)
# -----------------------------------------------------------
PORT=5000
